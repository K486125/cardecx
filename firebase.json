{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "cardecx",
    "public": "dist",
    "predeploy": ["node scripts/build.mjs"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
